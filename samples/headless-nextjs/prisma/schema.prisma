generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Thread {
  id           String    @id
  title        String?
  lastEditDate BigInt?
  provider     Json?
  model        Json?
  profileId    String?
  messages     Message[]
}

model Message {
  id        String @id
  threadId  String
  message   Json
  timestamp BigInt
  thread    Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model Profile {
  id   String @id
  data Json
}

model Prompt {
  id        String        @id
  name      String
  text      String
  folderId  String?
  createdAt BigInt
  updatedAt BigInt
  folder    PromptFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
}

model PromptFolder {
  id        String   @id
  name      String
  createdAt BigInt
  updatedAt BigInt
  prompts   Prompt[]
}
