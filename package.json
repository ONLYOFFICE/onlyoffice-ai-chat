{
  "name": "@onlyoffice/ai-chat",
  "version": "0.5.78",
  "description": "Headless AI chat widget with 16 providers, MCP tools, and pluggable adapters",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicedoc/onlyoffice-ai-chat"
  },
  "keywords": [
    "ai",
    "chat",
    "widget",
    "react",
    "mcp",
    "onlyoffice",
    "llm"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./providers": {
      "types": "./dist/core/providers/index.d.ts",
      "import": "./dist/core/providers/index.js"
    },
    "./services": {
      "types": "./dist/core/services/index.d.ts",
      "import": "./dist/core/services/index.js"
    },
    "./storage": {
      "types": "./dist/core/storage/index.d.ts",
      "import": "./dist/core/storage/index.js"
    },
    "./middleware": {
      "types": "./dist/core/middleware/index.d.ts",
      "import": "./dist/core/middleware/index.js"
    },
    "./store": {
      "types": "./dist/ui/store/index.d.ts",
      "import": "./dist/ui/store/index.js"
    },
    "./tools": {
      "types": "./dist/ui/tools/index.d.ts",
      "import": "./dist/ui/tools/index.js"
    },
    "./events": {
      "types": "./dist/ui/providers/EventsProvider/index.d.ts",
      "import": "./dist/ui/providers/EventsProvider/index.js"
    },
    "./hooks": {
      "types": "./dist/ui/hooks/index.d.ts",
      "import": "./dist/ui/hooks/index.js"
    },
    "./pages": {
      "types": "./dist/ui/pages/index.d.ts",
      "import": "./dist/ui/pages/index.js"
    },
    "./platform": {
      "types": "./dist/ui/providers/PlatformProvider/index.d.ts",
      "import": "./dist/ui/providers/PlatformProvider/index.js"
    },
    "./imperative": {
      "types": "./dist/ui/providers/ImperativeProvider/index.d.ts",
      "import": "./dist/ui/providers/ImperativeProvider/index.js"
    },
    "./providers/ApiProvider": {
      "types": "./dist/ui/providers/ApiProvider/index.d.ts",
      "import": "./dist/ui/providers/ApiProvider/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/themes": "./dist/styles/themes.css",
    "./themes/*": "./dist/styles/theme-*.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "generate:i18n": "node scripts/generate-i18n-types.mjs",
    "generate:theme": "node scripts/generate-theme-types.mjs",
    "generate:icons": "node scripts/generate-icon-types.mjs",
    "prebuild": "npm run generate:i18n && npm run generate:theme && npm run generate:icons",
    "build": "vite build && node scripts/copy-themes.mjs && node scripts/scope-preflight.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "pack:pre": "node scripts/pack-pre.mjs",
    "pack:docs": "node scripts/pack-pre.mjs --preid docs",
    "pack:docspace": "node scripts/pack-pre.mjs --preid docspace"
  },
  "dependencies": {
    "lodash.clonedeep": "^4.5.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@assistant-ui/react": "^0.11.0",
