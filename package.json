{
  "name": "@onlyoffice/ai-chat",
  "version": "0.1.7",
  "description": "Headless AI chat widget with 16 providers, MCP tools, and pluggable adapters",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicedoc/onlyoffice-ai-chat"
  },
  "keywords": [
    "ai",
    "chat",
    "widget",
    "react",
    "mcp",
    "onlyoffice",
    "llm"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "import": "./dist/settings/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./i18n": {
      "types": "./dist/locales/index.d.ts",
      "import": "./dist/locales/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./components": {
      "types": "./dist/components-provider/index.d.ts",
      "import": "./dist/components-provider/index.js"
    },
    "./images": {
      "types": "./dist/images-provider/index.d.ts",
      "import": "./dist/images-provider/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./styles": "./dist/styles/index.css",
    "./styles/themes": "./dist/styles/themes.css",
    "./themes/*": "./dist/styles/theme-*.css",
    "./locales/*": "./dist/locales/*.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "generate:i18n": "node scripts/generate-i18n-types.mjs",
    "generate:theme": "node scripts/generate-theme-types.mjs",
    "generate:icons": "node scripts/generate-icon-types.mjs",
    "prebuild": "npm run generate:i18n && npm run generate:theme && npm run generate:icons",
    "build": "vite build && cp src/styles/themes.css dist/styles/themes.css && cp src/styles/theme-*.css dist/styles/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@assistant-ui/react": "^0.11.0",
    "@assistant-ui/react-ai-sdk": "^1.1.0",
    "@assistant-ui/react-markdown": "^0.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.2",
    "@google/genai": "^1.30.0",
    "@lmstudio/sdk": "^1.5.0",
    "@mistralai/mistralai": "^1.11.0",
    "@openrouter/ai-sdk-provider": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "framer-motion": "^12.23.12",
    "i18next": "^25.5.2",
    "lodash.clonedeep": "^4.5.0",
    "ollama": "^0.5.17",
    "openai": "^5.22.0",
    "react-i18next": "^15.7.3",
    "react-shiki": "^0.8.0",
    "react-svg": "^16.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "together-ai": "^0.22.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/codemirror": "^5.60.16",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^4.0.14"
  }
}
